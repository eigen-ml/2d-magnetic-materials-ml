# Research environment for the v3 revision and DFT validation.
# The repository is mounted at /work instead of copied, so data and results stay on the host.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLBACKEND=Agg
WORKDIR /work

COPY requirements.txt requirements-api.txt requirements-research.txt ./
RUN pip install --no-cache-dir -r requirements-research.txt

CMD ["python", "-m", "pytest", "-q"]
