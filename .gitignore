# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Packaging and notebooks
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
*Zone.Identifier

# HPC and profiling output
slurm-*.out
*.prof

# Pipeline outputs. The current model, evaluation summaries and figures are
# tracked because the README and the API image use them; bulky or easily
# regenerated files stay local.
/data/combined_dataset.csv
/data/known_materials.txt
/results/*.csv.gz
/results/screened_candidates.csv
